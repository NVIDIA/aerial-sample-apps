# Sample environment file for split-6 docker compose (copy to split6.env and edit).
#
# Usage (from repo root):
#   docker compose --env-file docker/split6.env -f docker/docker-compose.yml --profile prod up -d
# Or: ./install.sh up
#
# Compose reads this file for ${VAR} substitution in the YAML (e.g. OPEN5GS_IP for 5GC network).
# The gNB services also load the same file via env_file, so uncommented KEY=value lines become
# container environment (e.g. GNB_CONFIG_TEMPLATE for render_gnb_config.sh).
#
# For a custom path, set SPLIT6_ENV_FILE to an absolute path and pass the same file to
#   docker compose --env-file "$SPLIT6_ENV_FILE" ...

# --- Required for compose (5GC + gNB network + config render) ---
OPEN5GS_IP=10.53.1.2
GNB_IP=10.53.1.3

# --- Optional: passed into gNB container when uncommented (render_gnb_config.sh) ---
# Selects a file under GNB_CONFIG_DIR, mounted in the container at /configs.
# Optional overlay layered on top with a second -c; it wins per setting.
GNB_CONFIG_FILE=gnb_split6.yml
# GNB_CONFIG_OVERLAY=gnb_split6_n78_n48.yml
# Aerial L1 owns cores 4-11 (workers_ul 4-5, workers_dl 6-8, low_priority_core 10,
# h2d_copy 11), so keep the gNB mask clear of that range. Pool size is
# min(GNB_MAIN_POOL_NOF_THREADS, nof_mask_cores - 3). 7 cores allow 4 workers.
GNB_MAIN_POOL_CPUS=12-18
GNB_MAIN_POOL_PINNING=mask
GNB_MAIN_POOL_NOF_THREADS=4

# --- Optional: override compose defaults (paths relative to compose file unless absolute) ---
# OPEN_5GS_ENV_FILE=../../../ocudu/docker/open5gs/open5gs.env
# GNB_CONFIG_DIR=../configs
# OPEN5GS_IMAGE=ocudu/open5gs-5gc
# OPEN5GS_CONTAINER_NAME=open5gs_5gc
# GNB_IMAGE=ocudu/gnb
# GNB_CONTAINER_NAME=ocudu_gnb
# Subscriber DB mounted into 5GC. For a local UE DB, copy to configs/subscriber_db.local.csv and set:
# OPEN5GS_SUBSCRIBER_DB_PATH=../configs/subscriber_db.local.csv
OPEN5GS_SUBSCRIBER_DB_PATH=../configs/subscriber_db.csv

# --- Optional: gNB image build (prod profile `gnb` service) ---
# DEBUG_BUILD=0

# --- Optional: Aerial services ---
# AERIAL_BUILT_IMAGE=aerial-cuda-accelerated-ran:26-2_10.04
# AERIAL_CONTAINER_NAME=ocudu_aerial
# Arguments passed to run_l1.sh, for example: F08_CG1
# AERIAL_RUN_L1_ARGS=P5G_WNC_FXN_GH
# AERIAL_IMAGE=nvcr.io/nvidia/aerial/aerial-cuda-accelerated-ran:26-2-cubb
# AERIAL_DEV_VERSION=26-2
# AERIAL_PLATFORM=linux/arm64
# UID=1000
# GID=1000
