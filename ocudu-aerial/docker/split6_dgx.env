# Environment file for split-6 docker compose on DGX Spark (20-core Grace, CPUs 0-19).
#
# Usage (from repo root):
#   docker compose --env-file docker/split6_dgx.env -f docker/docker-compose.yml up -d
#
# Use docker/split6.env on the Grace host; this file documents the tighter DGX
# Spark core allocation and the experimental dedicated P7 receive-thread settings.

# --- Required for compose (5GC + gNB network + config render) ---
OPEN5GS_IP=10.53.1.2
GNB_IP=10.53.1.3

# --- Optional: passed into gNB container when uncommented (render_gnb_config.sh) ---
# Selects a file under GNB_CONFIG_DIR, mounted in the container at /configs.
# Optional overlay layered on top with a second -c; it wins per setting.
GNB_CONFIG_FILE=gnb_split6.yml
# GNB_CONFIG_OVERLAY=gnb_split6_n78_n48.yml

# --- gNB main worker pool (DGX Spark core layout) ---
# Only 20 CPUs on this platform, so the mask is far tighter than on the 72-core host.
# Aerial L1 sits below core 11; keep this mask clear of it.
#
# The worker manager reserves 3 cores of the mask as spare, so the pool size is
# min(GNB_MAIN_POOL_NOF_THREADS, nof_mask_cores - 3). This mask has 7 cores
# (11,12,13,14,17,18,19), which caps the pool at 4 workers -- asking for more is
# silently clamped, so NOF_THREADS is set to the achievable value.
GNB_MAIN_POOL_CPUS=11-14,17-19
GNB_MAIN_POOL_PINNING=mask
GNB_MAIN_POOL_NOF_THREADS=4

# --- Aerial P7 receive thread (DGX Spark) ---
# Gives the FAPI P7 receive path its own pinned SCHED_FIFO thread instead of leaving it
# as a task competing with the MAC/scheduler strands on the main pool.
#
# NOTE: these three have no effect on the current build of this repo. Three things must
# be wired up first:
#   1. scripts/run_gnb_split6.sh assigns OCUDU_AERIAL_P7_* but only exports NVIPC_LIB_PATH,
#      so getenv() in the plugin never sees them.
#   2. The gnb service in docker-compose.yml does not list OCUDU_AERIAL_P7_* under
#      environment:, and has no env_file:, so nothing from this file reaches the container
#      unless it is named there (GNB_MAIN_POOL_* above are, so those do apply).
#   3. apply_aerial_p7_thread_env(), which reads them, lives only in
#      ocudu/plugins/aerial/phy_fapi_adaptor_aerial.cpp, which no CMakeLists references.
#      The linked path (lib/aerial/hal/hal_factory.cpp) creates no thread at all -- it
#      re-defers receive_loop() onto a shared executor.
# Verify a thread named below actually exists before trusting these.
OCUDU_AERIAL_P7_RX_THREAD_NAME=gnb_p7_rx
OCUDU_AERIAL_P7_RX_CPU_AFFINITY=4
OCUDU_AERIAL_P7_RX_SCHED_PRIORITY=95

# --- Optional: override compose defaults (paths relative to compose file unless absolute) ---
# GNB_CONFIG_DIR=../configs
# GNB_IMAGE=ocudu/gnb
# GNB_CONTAINER_NAME=ocudu_gnb
OPEN5GS_SUBSCRIBER_DB_PATH=../configs/subscriber_db.csv

# --- Optional: Aerial services ---
# AERIAL_RUN_L1_ARGS=P5G_WNC_FXN_GH
# AERIAL_PLATFORM=linux/arm64
