    "subscriptionDelete": {
      "description": "dApp cancels an active subscription via PUB socket. Agent responds with subscriptionResponse.",
      "message": {
        "type": "subscriptionDelete",
        "id": 3,
        "dAppIdentifier": 1,
        "subscriptionId": 1
      }
    },

    "subscriptionDelete_response": {
      "description": "Agent confirms subscription deletion (reuses subscriptionResponse)",
      "message": {
        "type": "subscriptionResponse",
        "id": 5,
        "requestId": 3,
        "dAppIdentifier": 1,
        "responseCode": "positive",
        "subscriptionId": 1
      }
    },

    "dAppControlAction": {
      "description": "dApp sends a control action to the agent via PUB socket. Agent may optionally reply with messageAck.",
      "message": {
        "type": "dAppControlAction",
        "id": 4,
        "dAppIdentifier": 1,
        "ranFunctionIdentifier": 2,
        "controlIdentifier": 0,
        "actionData": {
          "sfn": 512,
          "slot": 5
        }
      }
    },

    "messageAck": {
      "description": "Optional acknowledgement from agent (e.g., for control actions)",
      "message": {
        "type": "messageAck",
        "id": 6,
        "requestId": 4,
        "dAppIdentifier": 1,
        "responseCode": "negative",
        "message": "control actions not implemented"
      }
    },

    "releaseMessage_from_dapp": {
      "description": "dApp tears down connection via PUB socket. No response required.",
      "message": {
        "type": "releaseMessage",
        "id": 5,
        "dAppIdentifier": 1
      }
    },

    "releaseMessage_from_agent": {
      "description": "Agent tears down connection via PUB socket (e.g., dApp inactivity timeout).",
      "message": {
        "type": "releaseMessage",
        "id": 200,
        "dAppIdentifier": 1
      }
    }
  },

  "message_flow_examples": {
    "typical_session": {
      "description": "Complete dApp session: setup, subscribe, receive indications, unsubscribe, release",
      "sequence": [
        { "step": 1, "direction": "dApp -> Agent", "socket": "REQ/REP", "type": "setupRequest", "note": "Establish connection" },
        { "step": 2, "direction": "Agent -> dApp", "socket": "REQ/REP", "type": "setupResponse", "note": "dAppIdentifier assigned" },
        { "step": 3, "direction": "dApp -> Agent", "socket": "PUB",     "type": "subscriptionRequest", "note": "Subscribe to telemetry" },
        { "step": 4, "direction": "Agent -> dApp", "socket": "PUB",     "type": "subscriptionResponse", "note": "subscriptionId assigned" },
        { "step": 5, "direction": "Agent -> dApp", "socket": "PUB",     "type": "indicationMessage", "note": "Repeats at granted periodicity" },
        { "step": 6, "direction": "dApp -> Agent", "socket": "PUB",     "type": "subscriptionDelete", "note": "Cancel subscription" },
        { "step": 7, "direction": "Agent -> dApp", "socket": "PUB",     "type": "subscriptionResponse", "note": "Deletion confirmed" },
        { "step": 8, "direction": "dApp -> Agent", "socket": "PUB",     "type": "releaseMessage", "note": "Tear down connection" }
      ]
    },
    "control_action_during_subscription": {
      "description": "dApp sends a control action while subscribed (after steps 1-4 above)",
      "sequence": [
        { "step": 1, "direction": "dApp -> Agent", "socket": "PUB", "type": "dAppControlAction", "note": "Send control action" },
        { "step": 2, "direction": "Agent -> dApp", "socket": "PUB", "type": "messageAck", "note": "Optional acknowledgement" }
      ]
    }
  },

  "client_command_examples": {
    "_description": "Commands sent by external clients (e.g., e3_client.py or e3_e2e_test.py) to the dApp's ZMQ REP interface",

    "subscribe_pusch": {
      "description": "Subscribe to PUSCH telemetry streams (IQ + sfn/slot/mcs) through the dApp",
      "request": {
        "cmd": "subscribe",
        "agent": "NVIDIA_L1",
        "telemetryIdentifierList": [1, 4, 5, 6, 23],
        "ranFunctionIdentifier": 2,
        "periodicity": 100000,
        "subscriptionTime": 5,
        "model_name": "prb_power_numpy"
      },
      "response_success": {
        "status": "sent",
        "message": "subscription request sent",
        "agent": "NVIDIA_L1"
      },
      "response_error": {
        "status": "error",
        "message": "No indication handler set"
      }
    },

    "unsubscribe": {
      "description": "Cancel subscription on a specific agent",
      "request": {
        "cmd": "unsubscribe",
        "agent": "NVIDIA_L1"
      },
      "response_success": {
        "status": "sent",
        "message": "subscription delete sent",
        "agent": "NVIDIA_L1"
      }
    },

    "status": {
      "description": "Query status of all agents and their subscriptions",
      "request": {
        "cmd": "status"
      },
      "response": {
        "status": "ok",
        "agents": [
          {
            "name": "NVIDIA_L1",
            "state": "connected",
            "is_subscribed": true,
            "subscription_id": 1,
            "subscription_status": "confirmed",
            "model": "prb_power_numpy"
          }
        ]
      }
    },

    "list_agents": {
      "description": "List all configured E3 Agents",
      "request": {
        "cmd": "list_agents"
      },
      "response": {
        "status": "ok",
        "agents": [
          {
            "name": "NVIDIA_L1",
            "host": "127.0.0.1",
            "agent_rep_port": 5557,
            "agent_pub_port": 5558,
            "state": "connected"
          }
        ]
      }
    },

    "e3_setup": {
      "description": "Manually trigger E3 setup for a specific agent (or all if agent omitted)",
      "request": {
        "cmd": "e3_setup",
        "agent": "NVIDIA_L1"
      },
      "response_success": {
        "status": "ok",
        "message": "setup complete",
        "agent": "NVIDIA_L1"
      }
    },

    "e3_release": {
      "description": "Manually release E3 connection for a specific agent (or all if agent omitted)",
      "request": {
        "cmd": "e3_release",
        "agent": "NVIDIA_L1"
      },
      "response_success": {
        "status": "ok",
        "message": "released",
        "agent": "NVIDIA_L1"
      }
    }
  }
}
