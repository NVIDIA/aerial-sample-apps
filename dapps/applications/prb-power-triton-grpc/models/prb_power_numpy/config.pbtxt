name: "prb_power_numpy"
backend: "python"

input [
  {
    name: "iq_samples"
    data_type: TYPE_FP16
    dims: [ 4, 14, 273, 12, 2 ]
  }
]

output [
  {
    name: "prb_power"
    data_type: TYPE_FP32
    dims: [ 273 ]
  },
  {
    name: "timing_us"
    data_type: TYPE_FP64
    dims: [ 2 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]