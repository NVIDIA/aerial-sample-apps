{
  "_copyright": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved. SPDX-License-Identifier: Apache-2.0",
  "deployment": {
    "ipc_mode": "container:nv-cubb",
    "shared_memory": {
      "key": "/e3_ran_buffers",
      "required": true
    }
  },
  "application": {
    "name": "PRB Power Triton",
    "version": "1.1.0",
    "vendor": "NVIDIA",
    "results_pub_port": 5559,
    "enable_results_publishing": true,
    "visualizer": {
      "enabled": true,
      "web_port": 5001
    }
  },
  "e3_manager": {
    "dapp_client_endpoint": "tcp://*:5558",
    "e3_agents": [
      {
        "name": "NVIDIA_L1",
        "enabled": true,
        "host": "127.0.0.1",
        "agent_rep_port": 5555,
        "agent_pub_port": 5556,
        "agent_sub_port": 5557,
        "auto_setup": true,
        "subscription_options": {
          "auto_subscribe": false,
          "telemetry_ids": [1, 4, 5, 6],
          "control_ids": [],
          "ran_function_id": 2,
          "periodicity_us": 100000,
          "subscription_time_s": 0
        },
        "comment": "NVIDIA L1 E3 Agent"
      },
      {
        "name": "OAI_L2",
        "enabled": false,
        "host": "127.0.0.1",
        "agent_rep_port": 9990,
        "agent_pub_port": 9991,
        "agent_sub_port": 9999,
        "auto_setup": true,
        "subscription_options": {
          "auto_subscribe": false
        },
        "comment": "OAI L2 E3 Agent"
      }
    ],
    "default_model": "prb_power_numpy",
    "subscription_response_timeout_s": 10,
    "debug_enabled": false
  },
  "triton": {
    "model_repository": "/models",
    "startup_timeout_seconds": 30
  },
  "logging": {
    "directory": "/logs",
    "triton_log": "triton.log",
    "e3_manager_log": "e3_manager.log",
    "visualizer_log": "visualizer.log"
  }
} 